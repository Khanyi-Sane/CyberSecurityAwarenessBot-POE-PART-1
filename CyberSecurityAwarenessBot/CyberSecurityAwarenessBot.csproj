<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Audio\greeting.wav" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Audio\greeting.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aghili.Extensions.System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.12" />
  </ItemGroup>

</Project>
